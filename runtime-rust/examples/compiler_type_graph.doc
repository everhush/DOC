# A bounded typed DAG checker using ordinary DOC values, not a new host primitive.
# Each tagged record is [opcode, operand A, operand B].
# 0 int literal (B=0); 1 bool literal (A=0/1,B=0);
# 2 add(int,int)->int; 3 less(int,int)->bool; 4 equal(T,T)->bool.
# References are indices of earlier records. The growing type table is immutable.
# Output: 0=int, 1=bool. Malformed graph fails without publishing a new table.
fn bad(unused) = get(empty(),0)
fn literal(t,a,b) = if(eq(b,0),if(eq(t,0),0,if(if(le(0,a),le(a,1),false),1,bad(0))),bad(0))
fn binary(t,a,b) = if(eq(t,4),if(eq(a,b),1,bad(0)),if(if(eq(a,0),eq(b,0),false),if(eq(t,2),0,1),bad(0)))
fn kind(t,a,b,types) = if(if(le(0,t),le(t,1),false),literal(t,a,b),if(if(le(2,t),le(t,4),false),binary(t,get(types,a),get(types,b)),bad(0)))
fn step(types,rows) = append(types,kind(get(rows,mul(len(types),3)),get(rows,add(mul(len(types),3),1)),get(rows,add(mul(len(types),3),2)),types))
source records: ints = [0,17,0,0,3,0,2,0,1,3,1,2,1,1,0,4,3,4]
derive count: int (records) = if(eq(mul(quot(len(records),3),3),len(records)),quot(len(records),3),bad(0))
derive seed: ints () = empty()
derive types: ints (seed,records,count) = recur(seed,table,eq(len(table),count),step(table,records))
