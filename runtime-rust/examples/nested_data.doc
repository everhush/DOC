# A composable tagged prefix tree in immutable DOC ints.
# 0 integer payload; 1 bool payload (0/1); 2 UTF-8 byte length + bytes;
# 3 product/collection child count + children; 4 none; 5 some + child.
# The private state is [cursor, outstanding children, nodes].
# No pointers, recursion on the host, manual memory or sequential source code.
fn bad(s) = append(s,get(empty(),0))
fn advance(s,cursor,children) = replace_at(replace_at(replace_at(s,0,cursor),1,add(sub(get(s,1),1),children)),2,add(get(s,2),1))
fn boolean(s,b) = if(if(le(0,b),le(b,1),false),advance(s,add(get(s,0),2),0),bad(s))
fn text_value(s,xs,n) = advance(s,add(add(get(s,0),2),len(utf8_text(slice(xs,add(get(s,0),2),n)))),0)
fn product(s,n) = if(if(le(0,n),le(n,65536),false),advance(s,add(get(s,0),2),n),bad(s))
fn step(s,xs,t) = if(eq(t,0),advance(s,add(get(s,0),2),0),if(eq(t,1),boolean(s,get(xs,add(get(s,0),1))),if(eq(t,2),text_value(s,xs,get(xs,add(get(s,0),1))),if(eq(t,3),product(s,get(xs,add(get(s,0),1))),if(eq(t,4),advance(s,add(get(s,0),1),0),if(eq(t,5),advance(s,add(get(s,0),1),1),bad(s)))))))
source encoded: ints = [3,3,0,42,5,2,2,195,169,4]
derive seed: ints () = append(append(append(empty(),0),1),0)
derive scan: ints (seed,encoded) = recur(seed,s,eq(get(s,1),0),step(s,encoded,get(encoded,get(s,0))))
derive summary: ints (scan,encoded) = if(eq(get(scan,0),len(encoded)),scan,bad(scan))
