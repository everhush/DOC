# Radar Chase: unified playable DOC engine showcase, all gameplay in DOC.
# No worker count, backend, GPU or placement hints in authored source.
# The host supplies ONLY the ordered action fact and displays stable DOC values.
# Action: 0 idle, 1 up, 2 down, 3 left, 4 right, 5 pause, 6 restart.
# All coordinates, rewards, wall collisions and terminal conditions are DOC.
import engine_math.doc
import entity_pool.doc
# Explicit, startup-only typed scene asset read, not a hidden pure effect.
effect level: ints = read("levels/coin_chase.txt")
effect prefab_template_xs: ints = read("levels/showcase_xs.txt")
effect prefab_template_ys: ints = read("levels/showcase_ys.txt")
source frame: int = -1
source player_x: int = 1
source player_y: int = 1
source coin_x: int = 4
source coin_y: int = 2
source score: int = 0
source paused: bool = false
source won: bool = false
source action: int = 0
source animation_phase: int = 0
# Bounded DOC-authored dynamic prefab world. e instantiates, x despawns.
source entity_ids: ints = []
source entity_xs: ints = []
source entity_ys: ints = []
source next_entity_id: int = 1
source issued_high_water: int = 0
source entity_capacity: int = 4
source spawn_template: int = 0
source remove_slot: int = 0
# Explicit typed data reload facts; invalid mismatched arrays fail atomically.
source reload: bool = false
source replacement_xs: ints = []
source replacement_ys: ints = []
source query_slot: int = 0
source query_id: int = 1
# Scene dimensions, obstacle placement and target are derived from the
# immutable typed level data fact; not hard-coded in the Rust window host.
derive width: int (level) = get(level,0)
derive height: int (level) = get(level,1)
derive wall_x: int (level) = get(level,2)
derive wall_y: int (level) = get(level,3)
derive goal: int (level) = get(level,4)

derive next_frame: int (frame) = add(frame,1)
derive next_paused: bool (paused,action) = if(eq(action,6),false,if(eq(action,5),eq(paused,false),paused))
derive active: bool (paused,won,action) = if(eq(action,5),false,if(eq(action,6),false,if(paused,false,if(won,false,true))))
derive dx: int (action) = if(eq(action,4),1,if(eq(action,3),-1,0))
derive dy: int (action) = if(eq(action,2),1,if(eq(action,1),-1,0))
derive candidate_x: int (player_x,dx) = add(player_x,dx)
derive candidate_y: int (player_y,dy) = add(player_y,dy)
derive bounded_x: int (candidate_x,width) = clamp(candidate_x,0,sub(width,1))
derive bounded_y: int (candidate_y,height) = clamp(candidate_y,0,sub(height,1))
derive wall_hit: bool (bounded_x,bounded_y,wall_x,wall_y) = same_cell(bounded_x,bounded_y,wall_x,wall_y)
# Dynamic prefab obstacles are collision bodies, using typed DOC components.
# Four fixed probes implement a bounded world query without a host physics system.
derive hit_0: bool (entity_xs,entity_ys,bounded_x,bounded_y) = if(lt(0,len(entity_xs)),if(eq(get(entity_xs,0),bounded_x),eq(get(entity_ys,0),bounded_y),false),false)
derive hit_1: bool (entity_xs,entity_ys,bounded_x,bounded_y) = if(lt(1,len(entity_xs)),if(eq(get(entity_xs,1),bounded_x),eq(get(entity_ys,1),bounded_y),false),false)
derive hit_2: bool (entity_xs,entity_ys,bounded_x,bounded_y) = if(lt(2,len(entity_xs)),if(eq(get(entity_xs,2),bounded_x),eq(get(entity_ys,2),bounded_y),false),false)
derive hit_3: bool (entity_xs,entity_ys,bounded_x,bounded_y) = if(lt(3,len(entity_xs)),if(eq(get(entity_xs,3),bounded_x),eq(get(entity_ys,3),bounded_y),false),false)
derive entity_hit: bool (hit_0,hit_1,hit_2,hit_3) = if(hit_0,true,if(hit_1,true,if(hit_2,true,hit_3)))
derive cell_blocked: bool (wall_hit,entity_hit) = if(wall_hit,true,entity_hit)
derive next_x: int (action,active,cell_blocked,player_x,bounded_x) = if(eq(action,6),1,if(active,if(cell_blocked,player_x,bounded_x),player_x))
derive next_y: int (action,active,cell_blocked,player_y,bounded_y) = if(eq(action,6),1,if(active,if(cell_blocked,player_y,bounded_y),player_y))
derive collected: bool (active,next_x,next_y,coin_x,coin_y) = if(active,same_cell(next_x,next_y,coin_x,coin_y),false)
derive next_score: int (action,collected,score) = if(eq(action,6),0,if(collected,add(score,1),score))
derive next_won: bool (action,won,next_score,goal) = if(eq(action,6),false,if(le(goal,next_score),true,won))
derive next_coin_x: int (action,collected,coin_x) = if(eq(action,6),4,if(collected,6,coin_x))
derive next_coin_y: int (action,collected,coin_y) = if(eq(action,6),2,if(collected,4,coin_y))
# Explicit DOC-authored audio event. The host may emit an optional real WAV effect
# ONLY after this stable epoch; no audio device or sound generation runs in pure DOC.
derive audio_hz: int (collected) = if(collected,880,0)
derive audio_ms: int (collected) = if(collected,120,0)
# DOC-authored looping presentation phase. Pausing freezes it; restart resets it.
derive next_animation_phase: int (animation_phase,next_paused,action) = if(eq(action,6),0,if(next_paused,animation_phase,if(lt(animation_phase,15),add(animation_phase,1),0)))

# Stable DOC entity lifetimes, typed prefab replacement and non-reused identity.
derive template_next_xs: ints (prefab_template_xs,reload,replacement_xs,replacement_ys) = if(reload,if(eq(len(replacement_xs),len(replacement_ys)),replacement_xs,remove_at(replacement_xs,-1)),prefab_template_xs)
derive template_next_ys: ints (prefab_template_ys,reload,replacement_xs,replacement_ys) = if(reload,if(eq(len(replacement_xs),len(replacement_ys)),replacement_ys,remove_at(replacement_ys,-1)),prefab_template_ys)
derive template_valid: bool (template_next_xs,template_next_ys,spawn_template) = if(lt(spawn_template,0),false,if(eq(len(template_next_xs),len(template_next_ys)),lt(spawn_template,len(template_next_xs)),false))
derive template_x: int (template_next_xs,spawn_template,template_valid) = if(template_valid,get(template_next_xs,spawn_template),0)
derive template_y: int (template_next_ys,spawn_template,template_valid) = if(template_valid,get(template_next_ys,spawn_template),0)
derive bounded_capacity: int (entity_capacity) = if(lt(entity_capacity,0),0,if(lt(4,entity_capacity),4,entity_capacity))
derive spawn_allowed: bool (action,template_valid,entity_ids,bounded_capacity,next_entity_id,issued_high_water) = if(eq(action,7),if(template_valid,if(lt(len(entity_ids),bounded_capacity),lt(issued_high_water,next_entity_id),false),false),false)
derive despawn_allowed: bool (action,entity_ids,remove_slot) = if(eq(action,8),if(lt(remove_slot,0),false,lt(remove_slot,len(entity_ids))),false)
derive next_entity_ids: ints (entity_ids,next_entity_id,spawn_allowed,remove_slot,despawn_allowed) = entity_remove(entity_insert(entity_ids,next_entity_id,spawn_allowed),remove_slot,despawn_allowed)
derive next_entity_xs: ints (entity_xs,template_x,spawn_allowed,remove_slot,despawn_allowed) = entity_remove(entity_insert(entity_xs,template_x,spawn_allowed),remove_slot,despawn_allowed)
derive next_entity_ys: ints (entity_ys,template_y,spawn_allowed,remove_slot,despawn_allowed) = entity_remove(entity_insert(entity_ys,template_y,spawn_allowed),remove_slot,despawn_allowed)
derive next_next_entity_id: int (next_entity_id,spawn_allowed) = if(spawn_allowed,add(next_entity_id,1),next_entity_id)
derive next_issued_high_water: int (issued_high_water,next_entity_id,spawn_allowed) = if(spawn_allowed,next_entity_id,issued_high_water)
derive next_entity_count: int (next_entity_ids) = len(next_entity_ids)
derive queried_alive: bool (next_entity_ids,query_slot,query_id) = entity_slot_is(next_entity_ids,query_slot,query_id)
derive queried_x: int (next_entity_xs,query_slot,queried_alive) = entity_position(next_entity_xs,query_slot,queried_alive)
derive queried_y: int (next_entity_ys,query_slot,queried_alive) = entity_position(next_entity_ys,query_slot,queried_alive)

# Every grid tile has two independent DOC-authored radar/visibility probes.
# These 128 actual independent game states are eligible for the native
# automatic scheduler; the DOC source never chooses CPU, GPU or thread count.
# They also remain ordinary pure DOC values, checked by the CPU oracle.
derive radar_player_0_0: bool (player_x,player_y) = if(eq(player_x,0),eq(player_y,0),false)
derive radar_player_1_0: bool (player_x,player_y) = if(eq(player_x,1),eq(player_y,0),false)
derive radar_player_2_0: bool (player_x,player_y) = if(eq(player_x,2),eq(player_y,0),false)
derive radar_player_3_0: bool (player_x,player_y) = if(eq(player_x,3),eq(player_y,0),false)
