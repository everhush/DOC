# Scalar semantic compiler slice. Source and derive int/bool, topological
# declaration order, explicit premises and pure checked operations. No host
# parser or evaluator participates in the independent semantic decision.
fn is_type(w) = if(eq(w,text("int")),0,if(eq(w,text("bool")),1,bad()))
fn dtype(es,ts,bs,i) = is_type(ename(es,ts,bs,add(i,2)))
# Resolver state header: event cursor, backward search cursor, mode,
# declaration start, declaration role. Then one resolved event index per event.
fn rdone(s,v) = append(replace_at(replace_at(s,0,add(get(s,0),1)),2,0),v)
fn rseek(s,k) = replace_at(replace_at(s,1,sub(get(s,0),1)),2,k)
fn rdecl(s,r) = if(if(eq(r,1),true,eq(r,2)),rdone(replace_at(replace_at(s,3,get(s,0)),4,r),-1),preject(s))
fn rname(s,w) = if(is_bool(w),rdone(s,-1),if(eq(get(s,4),2),rseek(s,10),preject(s)))
fn ratom(s,a,w) = if(eq(a,1),rname(s,w),if(eq(a,2),rdone(s,-1),preject(s)))
fn rstart(s,k,a,w) = if(eq(k,1),rdecl(s,a),if(eq(k,2),rseek(s,2),if(eq(k,6),rseek(s,6),if(eq(k,10),ratom(s,a,w),if(eq(k,13),if(eq(get(s,4),2),rdone(s,-1),preject(s)),if(eq(k,11),if(if(eq(a,43),eq(get(s,4),2),false),preject(s),rdone(s,-1)),if(le(17,k),preject(s),rdone(s,-1))))))))
fn rmiss(s) = replace_at(s,1,sub(get(s,1),1))
fn rmatch_decl(s) = if(eq(get(s,2),2),preject(s),rdone(s,get(s,1)))
fn rmatch_premise(s) = if(eq(get(s,2),6),preject(s),rdone(s,get(s,add(5,get(s,1)))))
fn rfound(s,k) = if(eq(k,2),rmatch_decl(s),rmatch_premise(s))
fn rpossible(s,k) = if(eq(k,2),if(eq(get(s,2),10),false,lt(get(s,1),get(s,3))),if(eq(k,6),if(lt(get(s,3),get(s,1)),if(eq(get(s,2),2),false,true),false),false))
fn rcompare(s,es,ts,bs,k) = if(rpossible(s,k),if(same_name(es,ts,bs,get(s,0),get(s,1)),rfound(s,k),rmiss(s)),rmiss(s))
fn rend(s) = if(eq(get(s,2),2),rdone(s,get(s,0)),preject(s))
fn rsearch(s,es,ts,bs) = if(lt(get(s,1),0),rend(s),if(if(eq(get(s,2),10),le(get(s,1),get(s,3)),false),preject(s),rcompare(s,es,ts,bs,ev(es,get(s,1)))))
fn rstep(s,es,ts,bs) = if(eq(get(s,2),0),rstart(s,ev(es,get(s,0)),ea(es,get(s,0)),if(if(eq(ev(es,get(s,0)),10),eq(ea(es,get(s,0)),1),false),ename(es,ts,bs,get(s,0)),text(""))),rsearch(s,es,ts,bs))
# Decimal admission, negative accumulation detects overflow including INT64_MIN.
# Header: event cursor, digit offset, digit end, negative accumulator, sign.
# Reverse expression type stack. Closing calls push a sentinel; opening call
# checks exact arity, argument kinds, and result; no runtime bytecode remains.
fn opcode(w) = if(eq(w,text("add")),1,if(eq(w,text("sub")),2,if(eq(w,text("mul")),3,if(eq(w,text("eq")),4,if(eq(w,text("lt")),5,if(eq(w,text("le")),6,if(eq(w,text("if")),7,bad())))))))
fn result2(op,a,b) = if(eq(op,4),if(eq(a,b),1,bad()),if(if(eq(a,0),eq(b,0),false),if(le(op,3),0,1),bad()))
fn result3(a,b,c) = if(if(eq(a,1),eq(b,c),false),b,bad())
fn tcall(s,op) = if(eq(op,7),if(if(le(6,len(s)),eq(top(s,3),-2),false),tpop(s,3,result3(top(s,0),top(s,1),top(s,2))),preject(s)),if(if(le(5,len(s)),eq(top(s,2),-2),false),tpop(s,2,result2(op,top(s,0),top(s,1))),preject(s)))
fn atomtype(es,ts,bs,rs,i) = if(eq(ea(es,i),2),0,if(eq(get(rs,i),-1),1,dtype(es,ts,bs,get(rs,i))))
fn tcheck(s,kind) = if(if(eq(len(s),3),eq(top(s,0),kind),false),slice(s,0,2),preject(s))
fn tbody(s) = if(eq(len(s),3),replace_at(s,1,0),preject(s))
fn tdispatch(s,es,ts,bs,rs,k,i) = if(eq(k,16),replace_at(s,1,1),if(eq(k,15),append(s,-2),if(eq(k,10),append(s,atomtype(es,ts,bs,rs,i)),if(eq(k,13),tcall(s,opcode(ename(es,ts,bs,i))),if(eq(k,7),tbody(s),if(eq(k,4),tcheck(s,is_type(ename(es,ts,bs,i))),s))))))
fn tstep(s,es,ts,bs,rs) = replace_at(tdispatch(s,es,ts,bs,rs,ev(es,get(s,0)),get(s,0)),0,sub(get(s,0),1))
# Code generation: fragments are generated from checked operator/type and
# identifier spans, never copied as unchecked C source. The output is one
# complete native C translation unit for the initial stable valuation.
fn cname(w) = concat(text("doc_v_"),w)
fn ctype(t) = if(eq(t,0),text("long long "),text("_Bool "))
fn cop(op) = if(eq(op,1),text("doc_add"),if(eq(op,2),text("doc_sub"),if(eq(op,3),text("doc_mul"),if(eq(op,4),text("doc_eq"),if(eq(op,5),text("doc_lt"),if(eq(op,6),text("doc_le"),text("DOC_IF")))))))
fn cheader() = concat(cat4(text("extern int printf(const char *, ...);"),nl(),text("extern void exit(int);"),nl()),concat(cat4(text("static long long doc_add(long long a,long long b){long long r;if(__builtin_add_overflow(a,b,&r))exit(1);return r;}"),nl(),text("static long long doc_sub(long long a,long long b){long long r;if(__builtin_sub_overflow(a,b,&r))exit(1);return r;}"),nl()),concat(cat4(text("static long long doc_mul(long long a,long long b){long long r;if(__builtin_mul_overflow(a,b,&r))exit(1);return r;}"),nl(),text("static _Bool doc_eq(long long a,long long b){return a==b;}"),nl()),concat(cat4(text("static _Bool doc_lt(long long a,long long b){return a<b;}"),nl(),text("static _Bool doc_le(long long a,long long b){return a<=b;}"),nl()),cat4(chr(35),text("define DOC_IF(c,a,b) ((c)?(a):(b))"),nl(),concat(text("int main(void) {"),nl()))))))
fn catom(es,ts,bs,rs,ns,i) = if(eq(ea(es,i),2),number_c(get(ns,i)),if(eq(get(rs,i),-1),if(eq(ename(es,ts,bs,i),text("true")),text("1"),text("0")),cname(ename(es,ts,bs,get(rs,i)))))
fn printvar(w,t) = if(eq(t,0),concat(cat4(text("printf("),quote(),w,text(": %lld")),concat(cat4(escape_n(),quote(),text(", (long long)"),cname(w)),concat(text(");"),nl()))),concat(cat4(text("printf("),quote(),w,text(": %s")),concat(cat4(escape_n(),quote(),text(", "),cname(w)),concat(cat4(text(" ? "),quote(),text("true"),quote()),cat4(text(" : "),quote(),text("false"),concat(quote(),concat(text(");"),nl())))))))
fn statement_piece(es,ts,bs,rs,ns,i,k,body) = if(eq(k,2),concat(ctype(dtype(es,ts,bs,i)),cname(ename(es,ts,bs,i))),if(eq(k,7),text(" = "),if(eq(k,10),catom(es,ts,bs,rs,ns,i),if(eq(k,13),cop(opcode(ename(es,ts,bs,i))),if(eq(k,14),text("("),if(eq(k,15),text(")"),if(eq(k,9),if(eq(body,1),text(","),text("")),if(eq(k,16),concat(text(";"),nl()),text("")))))))))
fn output_piece(es,ts,bs,i) = if(eq(ev(es,i),2),printvar(ename(es,ts,bs,i),dtype(es,ts,bs,i)),text(""))
# Emitter state: UTF-8 output bytes, then cursor and in-body flag.
fn e_stmt(s,es,ts,bs,rs,ns,i,k) = e_save(s,statement_piece(es,ts,bs,rs,ns,i,k,e_body(s)),add(i,1),if(eq(k,7),1,if(eq(k,16),0,e_body(s))))
fn estep(s,es,ts,bs,rs,ns) = if(lt(e_cursor(s),quot(len(es),3)),e_stmt(s,es,ts,bs,rs,ns,e_cursor(s),ev(es,e_cursor(s))),e_save(s,output_piece(es,ts,bs,sub(e_cursor(s),quot(len(es),3))),add(e_cursor(s),1),0))
