fn rn(id) = array_at(text("doc_need"),id)
fn assign(a,b) = cat4(a,text("="),b,concat(text(";"),nl()))
fn quoted_text(w) = cat3(quote(),w,quote())
fn evfun(w) = concat(text("doc_eval_"),w)
fn enum_decl(w,i) = concat(cat4(text("enum { "),did(w),text("="),number_c(i)),concat(text(" };"),nl()))
fn enum_piece(es,ts,bs,i) = if(eq(ev(es,i),2),concat(enum_decl(ename(es,ts,bs,i),i),if(eq(decl_role(es,i),2),cat4(text("static long long "),evfun(ename(es,ts,bs,i)),text("(void);"),nl()),text(""))),text(""))
fn init_decl(w,t,r) = concat(assign(array_at(text("doc_names"),did(w)),quoted_text(w)),concat(assign(array_at(text("doc_kind"),did(w)),if(eq(t,0),text("0"),text("1"))),concat(assign(array_at(text("doc_source"),did(w)),if(eq(r,1),text("1"),text("0"))),concat(assign(rd(did(w)),if(eq(r,2),text("1"),text("0"))),concat(assign(rh(did(w)),if(eq(r,1),text("1"),text("0"))),if(eq(r,2),assign(array_at(text("doc_fns"),did(w)),evfun(w)),text("")))))))
fn init_piece(es,ts,bs,rs,ns,owners,i,k) = if(eq(k,2),init_decl(ename(es,ts,bs,i),dtype(es,ts,bs,i),decl_role(es,i)),if(eq(k,10),if(eq(decl_role(es,owner(owners,i)),1),assign(rv(id_at(es,ts,bs,owner(owners,i))),catom(es,ts,bs,rs,ns,i)),text("")),text("")))
fn reactive_atom(es,ts,bs,rs,ns,i) = if(eq(ea(es,i),2),number_c(get(ns,i)),if(eq(get(rs,i),-1),if(eq(ename(es,ts,bs,i),text("true")),text("1"),text("0")),rv(id_at(es,ts,bs,get(rs,i)))))
fn eval_fragment(es,ts,bs,rs,ns,owners,i,k) = if(eq(k,2),cat3(text("static long long "),evfun(ename(es,ts,bs,i)),text("(void){return ")),if(eq(k,10),reactive_atom(es,ts,bs,rs,ns,i),if(eq(k,13),cop(opcode(ename(es,ts,bs,i))),if(eq(k,14),text("("),if(eq(k,15),text(")"),if(eq(k,9),if(eq(in_body(owners,i),1),text(","),text("")),if(eq(k,16),concat(text(";}"),nl()),text(""))))))))
fn eval_piece(es,ts,bs,rs,ns,owners,i,k) = if(eq(k,1),text(""),if(eq(decl_role(es,owner(owners,i)),2),eval_fragment(es,ts,bs,rs,ns,owners,i,k),text("")))
fn mark_piece(es,ts,bs,rs,owners,i) = if(eq(ev(es,i),6),concat(cat3(text("if(id=="),id_at(es,ts,bs,get(rs,i)),text(")")),assign(rd(id_at(es,ts,bs,owner(owners,i))),text("1"))),text(""))
fn need_piece(es,ts,bs,rs,owners,i) = if(eq(ev(es,i),6),concat(cat3(text("if("),rn(id_at(es,ts,bs,owner(owners,i))),text(")")),assign(rn(id_at(es,ts,bs,get(rs,i))),text("1"))),text(""))
fn block_piece(es,ts,bs,rs,owners,i) = if(eq(ev(es,i),6),cat4(cat4(text("if("),rd(id_at(es,ts,bs,get(rs,i))),text("||"),array_at(text("blocked"),id_at(es,ts,bs,get(rs,i)))),text(")"),assign(array_at(text("blocked"),id_at(es,ts,bs,owner(owners,i))),text("1")),text("")),text(""))
fn choose_decl(w) = concat(cat4(text("if("),rn(did(w)),text("&&"),rd(did(w))),concat(cat4(text("&&!"),array_at(text("blocked"),did(w)),text("){"),nl()),concat(assign(array_at(text("doc_selected"),did(w)),text("1")),concat(assign(text("doc_queue[count++]"),did(w)),concat(text("}"),nl())))))
fn choose_piece(es,ts,bs,i) = if(eq(ev(es,i),2),if(eq(decl_role(es,i),2),choose_decl(ename(es,ts,bs,i)),text("")),text(""))
fn stable_decl(w) = concat(cat4(text("if("),array_at(text("doc_selected"),did(w)),text("){"),nl()),concat(assign(text("long long candidate"),array_at(text("doc_candidates"),did(w))),concat(cat4(text("if(!"),rh(did(w)),text("||"),concat(rv(did(w)),text("!=candidate){"))),concat(assign(rv(did(w)),text("candidate")),concat(assign(rh(did(w)),text("1")),concat(cat4(text("doc_mark("),did(w),text(");}"),nl()),concat(assign(rd(did(w)),text("0")),concat(text("}"),nl()))))))))
fn stable_piece(es,ts,bs,i) = if(eq(ev(es,i),2),if(eq(decl_role(es,i),2),stable_decl(ename(es,ts,bs,i)),text("")),text(""))
fn rfragment(es,ts,bs,rs,ns,owners,i,phase) = if(eq(phase,0),enum_piece(es,ts,bs,i),if(eq(phase,1),init_piece(es,ts,bs,rs,ns,owners,i,ev(es,i)),if(eq(phase,2),eval_piece(es,ts,bs,rs,ns,owners,i,ev(es,i)),if(eq(phase,3),mark_piece(es,ts,bs,rs,owners,i),if(eq(phase,4),need_piece(es,ts,bs,rs,owners,i),if(eq(phase,5),block_piece(es,ts,bs,rs,owners,i),if(eq(phase,6),choose_piece(es,ts,bs,i),stable_piece(es,ts,bs,i))))))))
fn include_line(w) = cat4(chr(35),text("include <"),w,concat(text(">"),nl()))
fn support_prefix() = concat(text("static _Thread_local int doc_failed;"),concat(nl(),concat(cat4(text("static long long doc_add(long long a,long long b){long long r;if(__builtin_add_overflow(a,b,&r)){doc_failed=1;return 0;}return r;}"),nl(),text("static long long doc_sub(long long a,long long b){long long r;if(__builtin_sub_overflow(a,b,&r)){doc_failed=1;return 0;}return r;}"),nl()),concat(cat4(text("static long long doc_mul(long long a,long long b){long long r;if(__builtin_mul_overflow(a,b,&r)){doc_failed=1;return 0;}return r;}"),nl(),text("static _Bool doc_eq(long long a,long long b){return a==b;}"),nl()),concat(cat4(text("static _Bool doc_lt(long long a,long long b){return a<b;}"),nl(),text("static _Bool doc_le(long long a,long long b){return a<=b;}"),nl()),cat3(chr(35),text("define DOC_IF(c,a,b) ((c)?(a):(b))"),nl()))))))
fn rheader(n) = concat(cat3(chr(35),text("define _GNU_SOURCE"),nl()),concat(concat(include_line(text("stdio.h")),concat(include_line(text("stdlib.h")),concat(include_line(text("string.h")),concat(include_line(text("errno.h")),concat(include_line(text("ctype.h")),concat(include_line(text("pthread.h")),include_line(text("sched.h")))))))),concat(support_prefix(),concat(cat4(chr(35),text("define DOC_N "),number_c(n),nl()),concat(text("static long long doc_v[DOC_N],doc_candidates[DOC_N];static unsigned char doc_dirty[DOC_N],doc_have[DOC_N],doc_need[DOC_N],doc_kind[DOC_N],doc_source[DOC_N],doc_selected[DOC_N],doc_errors[DOC_N];static const char *doc_names[DOC_N];static long long (*doc_fns[DOC_N])(void);static size_t doc_queue[DOC_N];static unsigned long doc_evals;static int doc_execute(size_t count);"),nl())))))
fn rboundary(p) = if(eq(p,0),concat(text("static void doc_init(void){"),nl()),if(eq(p,1),concat(text("}"),nl()),if(eq(p,2),concat(text("static void doc_mark(long long id){"),nl()),if(eq(p,3),cat4(text("}"),nl(),text("static void doc_demand(void){"),nl()),if(eq(p,4),cat4(text("}"),nl(),text("static int doc_stabilize(void){for(;;){unsigned char blocked[DOC_N]={0};size_t count=0;memset(doc_selected,0,sizeof doc_selected);"),nl()),if(eq(p,5),text(""),if(eq(p,6),concat(text("if(!count)return 1;if(!doc_execute(count))return 0;doc_evals+=count;"),nl()),concat(text("}}"),nl()))))))))
fn r_emit(s,es,ts,bs,rs,ns,owners,n) = if(eq(e_cursor(s),n),e_save(s,rboundary(e_body(s)),0,add(e_body(s),1)),e_save(s,rfragment(es,ts,bs,rs,ns,owners,if(eq(e_body(s),4),sub(sub(n,1),e_cursor(s)),e_cursor(s)),e_body(s)),add(e_cursor(s),1),e_body(s)))
# Only the host CLI adapter is generic; the emitted graph/evaluation/repair
# functions above are specialized from the DOC program and its actual edges.
fn cli_find() = concat(text("static long long find(const char *name,size_t n){for(long long i=0;i<DOC_N;++i)if(doc_names[i]&&strlen(doc_names[i])==n&&!memcmp(doc_names[i],name,n))return i;return -1;}"),nl())
fn cli_value() = concat(text("static int value(const char *s,int kind,long long *out){while(isspace((unsigned char)*s))++s;size_t n=strlen(s);while(n&&isspace((unsigned char)s[n-1]))--n;if(kind){if(n==4&&!memcmp(s,"),concat(quoted_text(text("true")),concat(text(",4)){*out=1;return 1;}if(n==5&&!memcmp(s,"),concat(quoted_text(text("false")),concat(text(",5)){*out=0;return 1;}return 0;}if(!n)return 0;size_t k=(*s==43||*s==45);if(k==n)return 0;for(;k<n;++k)if(s[k]<48||s[k]>57)return 0;errno=0;char *end;long long v=strtoll(s,&end,10);if(errno||end!=s+n)return 0;*out=v;return 1;}"),nl())))))
fn cli_print() = concat(text("static void observe(long long target,int epochs,unsigned long epoch){for(long long i=0;i<DOC_N;++i)if(doc_names[i]&&(target<0||i==target)&&!doc_have[i])exit(1);if(epochs)printf("),concat(quoted_text(concat(text("epoch: %lu"),escape_n())),concat(text(",epoch);for(long long i=0;i<DOC_N;++i)if(doc_names[i]&&(target<0||i==target)){if(doc_kind[i])printf("),concat(quoted_text(concat(text("%s: %s"),escape_n())),concat(text(",doc_names[i],doc_v[i]?"),concat(quoted_text(text("true")),concat(text(":"),concat(quoted_text(text("false")),concat(text(");else printf("),concat(quoted_text(concat(text("%s: %lld"),escape_n())),concat(text(",doc_names[i],doc_v[i]);}fflush(stdout);}"),nl())))))))))))
fn cli_batch() = concat(text("static int batch(int argc,char **argv,int epochs,unsigned long epoch){long long pending[DOC_N],target=-1;unsigned char seen[DOC_N]={0};int start=0;if(argc&&!strncmp(argv[0],"),concat(quoted_text(text("--demand=")),concat(text(",9)){target=find(argv[0]+9,strlen(argv[0]+9));if(target<0)return 0;start=1;}for(int a=start;a<argc;++a){char *eq=strchr(argv[a],61);if(!eq)return 0;long long i=find(argv[a],(size_t)(eq-argv[a]));if(i<0||!doc_source[i]||seen[i]||!value(eq+1,doc_kind[i],&pending[i]))return 0;seen[i]=1;}for(long long i=0;i<DOC_N;++i)if(seen[i]&&pending[i]!=doc_v[i]){doc_v[i]=pending[i];doc_mark(i);}memset(doc_need,target<0?1:0,sizeof doc_need);if(target>=0){doc_need[target]=1;doc_demand();}doc_evals=0;if(!doc_stabilize())return 0;observe(target,epochs,epoch);fprintf(stderr,"),concat(quoted_text(concat(text("DOC11_REACTIVE_EVALUATIONS: %lu"),escape_n())),concat(text(",doc_evals);return 1;}"),nl())))))
fn cli_main() = concat(text("int main(int argc,char **argv){doc_init();++argv;--argc;if(argc&&!strcmp(argv[0],"),concat(quoted_text(text("--backend=cpu")),concat(text(")){++argv;--argc;}int epochs=0;for(int i=0;i<argc;++i)if(!strcmp(argv[i],"),concat(quoted_text(text("--next")),concat(text("))epochs=1;int start=0;unsigned long epoch=0;for(int i=0;i<=argc;++i){if(i==argc||!strcmp(argv[i],"),concat(quoted_text(text("--next")),concat(text(")){if(!batch(i-start,argv+start,epochs,epoch++))return 1;start=i+1;}}return 0;}"),nl())))))))
fn workers_code() = concat(text("static size_t workers(size_t count){if(count<32)return 1;cpu_set_t mask;size_t hw=1;if(sched_getaffinity(0,sizeof(mask),&mask)==0){int n=CPU_COUNT(&mask);if(n>0)hw=(size_t)n;}else if(errno==EINVAL){for(size_t bits=2u*CPU_SETSIZE;bits<=((size_t)-1)/2;bits*=2){cpu_set_t *large=CPU_ALLOC(bits);if(!large)break;size_t bytes=CPU_ALLOC_SIZE(bits);int rc=sched_getaffinity(0,bytes,large),error=errno;int n=rc==0?CPU_COUNT_S(bytes,large):0;CPU_FREE(large);if(rc==0){if(n>0)hw=(size_t)n;break;}if(error!=EINVAL)break;}}const char *raw=getenv("),concat(quoted_text(text("DOC_WORKERS")),concat(text(");if(raw&&*raw&&*raw!=45){char *end;errno=0;unsigned long long cap=strtoull(raw,&end,10);if(!errno&&!*end&&cap>0&&cap<hw)hw=(size_t)cap;}size_t grain=count/16;return hw<grain?hw:grain;}"),nl())))
fn thread_code() = concat(text("struct doc_job{size_t lo,hi;};static void *work(void *opaque){struct doc_job *j=opaque;for(size_t k=j->lo;k<j->hi;++k){size_t id=doc_queue[k];doc_failed=0;doc_candidates[id]=doc_fns[id]();doc_errors[id]=(unsigned char)doc_failed;}return 0;}static int doc_execute(size_t count){size_t n=workers(count),started=0;struct doc_job jobs[n];pthread_t threads[n];for(size_t i=0;i<n;++i){jobs[i].lo=count*i/n;jobs[i].hi=count*(i+1)/n;}for(size_t i=1;i<n;++i){if(pthread_create(&threads[i],0,work,&jobs[i]))break;++started;}work(&jobs[0]);for(size_t i=started+1;i<n;++i)work(&jobs[i]);int failed=0;for(size_t i=1;i<=started;++i)if(pthread_join(threads[i],0))failed=1;for(size_t i=0;i<count;++i)if(doc_errors[doc_queue[i]])failed=1;if(started)fprintf(stderr,"),concat(quoted_text(concat(text("DOC11_PARALLEL_FRONTIER: lanes=%zu workers=%zu"),escape_n())),concat(text(",count,started+1);return !failed;}"),nl())))
fn cli_adapter() = concat(workers_code(),concat(thread_code(),concat(cli_find(),concat(cli_value(),concat(cli_print(),concat(cli_batch(),cli_main()))))))
