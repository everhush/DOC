fn owner(owners,i) = get(owners,mul(i,2))
fn in_body(owners,i) = get(owners,add(mul(i,2),1))
fn decl_role(es,i) = ea(es,sub(i,1))
fn did(w) = concat(text("doc_id_"),w)
fn id_at(es,ts,bs,i) = did(ename(es,ts,bs,i))
fn array_at(name,id) = cat4(name,text("["),id,text("]"))
fn rv(id) = array_at(text("doc_v"),id)
fn rd(id) = array_at(text("doc_dirty"),id)
