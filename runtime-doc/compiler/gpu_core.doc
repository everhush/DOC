fn gpu_header() = concat(text("@group(0) @binding(0) var<storage,read> inputs: array<u32>; @group(0) @binding(1) var<storage,read> queue: array<u32>; @group(0) @binding(2) var<storage,read_write> out: array<u32>;"),concat(nl(),concat(text("fn g_add(a:i32,b:i32)->i32{return a+b;} fn g_sub(a:i32,b:i32)->i32{return a-b;} fn g_mul(a:i32,b:i32)->i32{return a*b;} fn g_quot(a:i32,b:i32)->i32{return a/b;} fn g_rem(a:i32,b:i32)->i32{return a%b;}"),concat(nl(),concat(text("fn g_eq(a:i32,b:i32)->i32{return select(0i,1i,a==b);} fn g_lt(a:i32,b:i32)->i32{return select(0i,1i,a<b);} fn g_le(a:i32,b:i32)->i32{return select(0i,1i,a<=b);} fn g_if(c:i32,a:i32,b:i32)->i32{return select(b,a,c!=0i);}"),concat(nl(),text("@compute @workgroup_size(64) fn main(@builtin(global_invocation_id) gid:vec3<u32>, @builtin(num_workgroups) groups:vec3<u32>){if(arrayLength(&queue)==0u||arrayLength(&inputs)==0u){return;}for(var idx=gid.x;idx<arrayLength(&out)/2u&&(arrayLength(&queue)==1u||idx<arrayLength(&queue));idx=idx+groups.x*64u){let state=queue[select(idx,0u,arrayLength(&queue)==1u)];var value=0u;var matched=false;")))))))
