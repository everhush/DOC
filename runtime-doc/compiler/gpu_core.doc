fn gpu_measure(s,es,ls,ns,i,k) = if(if(eq(k,10),eq(ea(es,i),2),false),if(if(le(-2147483648,get(ns,i)),le(get(ns,i),2147483647),false),gpu_measure_raw(s,es,ls,ns,i,k),replace_at(s,1,0)),gpu_measure_raw(s,es,ls,ns,i,k))
fn gpu_bound(ops) = if(eq(ops,0),2147483648,if(eq(ops,1),32767,if(le(ops,12),4,-1)))
fn gpu_finish(s,b) = append(s,if(eq(get(s,1),1),if(le(get(s,3),b),b,-1),-1))
fn gpu_check(s,es,ds,ls,ns,i,k,d) = if(eq(k,1),gpu_begin(s,ds,d),if(eq(k,16),gpu_finish(s,gpu_bound(get(s,2))),if(eq(get(s,1),1),if(gpu_event_ok(es,ds,ls,i,k),gpu_measure(s,es,ls,ns,i,k),replace_at(s,1,0)),s)))
fn gpu_scan(s,es,ds,ls,ns,owners) = replace_at(gpu_check(s,es,ds,ls,ns,get(s,0),ev(es,get(s,0)),get(owners,get(s,0))),0,add(get(s,0),1))
fn h8(v) = utf8_text(append(append(append(append(append(append(append(append(empty(),hn(v,28)),hn(v,24)),hn(v,20)),hn(v,16)),hn(v,12)),hn(v,8)),hn(v,4)),hn(v,0)))
fn gpu_uint(v) = cat3(text("0x"),h8(v),text("u"))
fn gpu_int(v) = cat3(text("bitcast<i32>("),gpu_uint(v),text(")"))
fn gpu_atom(es,ts,bs,ls,ns,i) = if(eq(ea(es,i),2),gpu_int(get(ns,i)),if(le(0,get(ls,i)),cat3(text("bitcast<i32>(inputs["),gpu_uint(get(ls,i)),text("])")),if(eq(ename(es,ts,bs,i),text("true")),text("1i"),text("0i"))))
fn gpu_body(es,ts,bs,ls,ns,i,k) = if(eq(k,10),gpu_atom(es,ts,bs,ls,ns,i),if(eq(k,13),concat(text("g_"),ename(es,ts,bs,i)),if(eq(k,14),text("("),if(eq(k,15),text(")"),if(eq(k,9),text(","),text(""))))))
fn gpu_case(d) = cat4(text("if(state=="),gpu_uint(d),text("){value = bitcast<u32>("),text(""))
fn gpu_piece(es,ts,bs,ds,ls,ns,bounds,owners,i,k,d) = if(lt(get(bounds,d),0),text(""),if(eq(k,7),gpu_case(d),if(eq(k,16),concat(text(" );matched=true;}"),nl()),if(lt(gbody(ds,d),i),gpu_body(es,ts,bs,ls,ns,i,k),text("")))))
fn gpu_emit(s,es,ts,bs,ds,ls,ns,bounds,owners) = e_save(s,gpu_piece(es,ts,bs,ds,ls,ns,bounds,owners,e_cursor(s),ev(es,e_cursor(s)),get(owners,e_cursor(s))),add(e_cursor(s),1),0)
fn gpu_header() = concat(text("@group(0) @binding(0) var<storage,read> inputs: array<u32>; @group(0) @binding(1) var<storage,read> queue: array<u32>; @group(0) @binding(2) var<storage,read_write> out: array<u32>;"),concat(nl(),concat(text("fn g_add(a:i32,b:i32)->i32{return a+b;} fn g_sub(a:i32,b:i32)->i32{return a-b;} fn g_mul(a:i32,b:i32)->i32{return a*b;}"),concat(nl(),concat(text("fn g_eq(a:i32,b:i32)->i32{return select(0i,1i,a==b);} fn g_lt(a:i32,b:i32)->i32{return select(0i,1i,a<b);} fn g_le(a:i32,b:i32)->i32{return select(0i,1i,a<=b);} fn g_if(c:i32,a:i32,b:i32)->i32{return select(b,a,c!=0i);}"),concat(nl(),text("@compute @workgroup_size(64) fn main(@builtin(global_invocation_id) gid:vec3<u32>){let idx=gid.x;if(idx>=arrayLength(&out)/2u||idx>=arrayLength(&queue)||arrayLength(&inputs)==0u){return;}let state=queue[idx];var value=0u;var matched=false;")))))))
