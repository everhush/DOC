# GPU admission derives from typed DOC declarations and expression events.
# Only total scalar operations; no unchecked i64 narrowing or evaluation on CPU.
fn scalar_kind(k) = if(eq(k,0),true,eq(k,1))
fn gpu_atom_ok(es,ds,ls,i) = if(eq(ea(es,i),2),true,if(eq(ea(es,i),1),if(eq(get(ls,i),-1),true,if(le(0,get(ls,i)),scalar_kind(gtype(ds,get(ls,i))),false)),false))
