derive e_seed: ints (checked,event_count) = if(if(eq(len(checked),2),lt(0,event_count),false),append(append(utf8_bytes(cheader()),0),0),preject(checked))
derive emitted: ints (e_seed,syntax,end_tokens,validated,resolved,numbers,event_count) = recur(e_seed,s,eq(e_cursor(s),mul(event_count,2)),estep(s,syntax,end_tokens,validated,resolved,numbers))
derive code: text (emitted) = concat(utf8_text(slice(emitted,0,sub(len(emitted),2))),concat(text("return 0;}"),nl()))
