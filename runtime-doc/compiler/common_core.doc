# Shared compiler event, literal, type-stack and emission primitives.
fn ev(es,i) = get(es,mul(i,3))
fn et(es,i) = get(es,add(mul(i,3),1))
fn ea(es,i) = get(es,add(mul(i,3),2))
fn ename(es,ts,bs,i) = pword(ts,bs,et(es,i))
fn same_name(es,ts,bs,a,b) = eq(ename(es,ts,bs,a),ename(es,ts,bs,b))
fn is_bool(w) = if(eq(w,text("true")),true,eq(w,text("false")))
fn ndone(s,v) = append(replace_at(replace_at(s,0,add(get(s,0),1)),2,0),v)
fn nnegative(es,i) = if(lt(0,i),if(eq(ev(es,sub(i,1)),11),eq(ea(es,sub(i,1)),45),false),false)
fn adjacent(ts,a,b) = eq(add(get(ts,add(mul(a,3),1)),get(ts,add(mul(a,3),2))),get(ts,add(mul(b,3),1)))
fn signed_adjacent(es,ts,i) = if(lt(0,i),if(eq(ev(es,sub(i,1)),11),adjacent(ts,et(es,sub(i,1)),et(es,i)),true),true)
fn nstart_raw(s,ts,es,i) = replace_at(replace_at(replace_at(replace_at(s,1,get(ts,add(mul(et(es,i),3),1))),2,add(get(ts,add(mul(et(es,i),3),1)),get(ts,add(mul(et(es,i),3),2)))),3,0),4,if(nnegative(es,i),1,0))
fn nstart(s,ts,es,i) = if(signed_adjacent(es,ts,i),nstart_raw(s,ts,es,i),preject(s))
fn nscan(s,bs) = replace_at(replace_at(s,3,sub(mul(get(s,3),10),sub(get(bs,get(s,1)),48))),1,add(get(s,1),1))
fn nstep(s,es,ts,bs) = if(eq(get(s,2),0),if(if(eq(ev(es,get(s,0)),10),eq(ea(es,get(s,0)),2),false),nstart(s,ts,es,get(s,0)),ndone(s,0)),if(eq(get(s,1),get(s,2)),ndone(s,if(eq(get(s,4),1),get(s,3),sub(0,get(s,3)))),nscan(s,bs)))
fn top(s,n) = get(s,sub(sub(len(s),1),n))
fn tpop(s,n,v) = append(slice(s,0,sub(len(s),add(n,1))),v)
fn hexchar(n) = if(lt(n,10),add(48,n),add(87,n))
fn hn(v,k) = hexchar(bit_and(shift_right(v,k),15))
fn h16(v) = utf8_text(append(append(append(append(append(append(append(append(append(append(append(append(append(append(append(append(empty(),hn(v,60)),hn(v,56)),hn(v,52)),hn(v,48)),hn(v,44)),hn(v,40)),hn(v,36)),hn(v,32)),hn(v,28)),hn(v,24)),hn(v,20)),hn(v,16)),hn(v,12)),hn(v,8)),hn(v,4)),hn(v,0)))
fn number_c(n) = if(lt(n,0),concat(text("(-1LL - 0x"),concat(h16(bit_not(n)),text("LL)"))),concat(text("0x"),concat(h16(n),text("LL"))))
fn cat3(a,b,c) = concat(concat(a,b),c)
fn cat4(a,b,c,d) = concat(concat(a,b),concat(c,d))
fn chr(c) = utf8_text(append(empty(),c))
fn nl() = chr(10)
fn quote() = chr(34)
fn escape_n() = concat(chr(92),text("n"))
fn e_cursor(s) = top(s,1)
fn e_body(s) = top(s,0)
fn e_save(s,fragment,i,b) = append(append(utf8_bytes(concat(utf8_text(slice(s,0,sub(len(s),2))),fragment)),i),b)
