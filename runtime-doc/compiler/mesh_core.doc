fn mesh_header() = concat(text("struct Params {words:array<vec4<i32>,2>,} @group(0) @binding(0) var<uniform> params:Params; struct Vertex {@location(0) a0:vec4<i32>,@location(1) a1:vec4<i32>,@location(2) a2:vec4<i32>,} struct Varyings {@builtin(position) position:vec4<f32>,@location(0) @interpolate(flat) shade:vec3<i32>,}"),concat(nl(),concat(text("fn g_add(a:i32,b:i32)->i32{return a+b;} fn g_sub(a:i32,b:i32)->i32{return a-b;} fn g_mul(a:i32,b:i32)->i32{return a*b;} fn g_eq(a:i32,b:i32)->i32{return select(0i,1i,a==b);} fn g_lt(a:i32,b:i32)->i32{return select(0i,1i,a<b);} fn g_le(a:i32,b:i32)->i32{return select(0i,1i,a<=b);} fn g_if(c:i32,a:i32,b:i32)->i32{return select(b,a,c!=0i);}"),nl())))
