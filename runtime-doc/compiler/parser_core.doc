fn pp(s,p) = replace_at(s,1,p)
fn pd(s,d) = replace_at(s,2,d)
fn pe(s,k,a) = append(append(append(s,k),get(s,0)),a)
fn pnext(s,p,k,a) = pp(pe(s,k,a),p)
fn preject(s) = replace_at(s,0,bad())
fn pexpect(s,c,want,p,k,a) = if(eq(c,want),pnext(s,p,k,a),preject(s))
fn prole(w) = if(eq(w,text("source")),1,if(eq(w,text("derive")),2,if(eq(w,text("fn")),3,if(eq(w,text("import")),4,if(eq(w,text("effect")),5,0)))))
fn pbegin(s,r) = replace_at(pnext(s,if(eq(r,4),18,1),1,r),3,r)
fn pstart(s,c,w) = if(eq(c,10),s,if(eq(c,1),if(eq(prole(w),0),preject(s),pbegin(s,prole(w))),preject(s)))
fn pname(s,c) = pexpect(s,c,1,if(eq(get(s,3),3),4,2),2,0)
fn pcolon(s,c) = pexpect(s,c,58,3,3,0)
fn ptype(s,c) = pexpect(s,c,1,4,4,0)
fn pheader(s,c) = if(if(eq(get(s,3),1),true,eq(get(s,3),5)),pexpect(s,c,61,9,7,0),pexpect(s,c,40,5,5,0))
fn ppremise(s,c) = pexpect(s,c,1,7,6,0)
fn pparam(s,c) = if(eq(c,41),pnext(s,8,8,0),ppremise(s,c))
fn pparam_after(s,c) = if(eq(c,44),pnext(s,6,9,0),pexpect(s,c,41,8,8,0))
fn popen(s,c) = if(eq(c,40),pd(pnext(s,10,14,0),add(get(s,2),1)),preject(s))
fn pclose(s) = if(lt(0,get(s,2)),pd(pnext(s,12,15,0),sub(get(s,2),1)),preject(s))
fn patom(s,c,n) = if(eq(c,1),if(eq(n,40),pnext(s,11,13,0),pnext(s,12,10,c)),if(if(eq(c,2),true,eq(c,3)),pnext(s,12,10,c),preject(s)))
fn pvalue(s,c,n) = if(if(eq(c,45),true,eq(c,43)),pnext(s,13,11,c),if(eq(c,91),if(if(eq(get(s,3),1),eq(get(s,2),0),false),pnext(s,14,17,0),preject(s)),patom(s,c,n)))
fn pempty(s,c,n) = if(eq(c,41),pclose(s),pvalue(s,c,n))
fn pend(s) = if(eq(get(s,2),0),pnext(s,0,16,0),preject(s))
fn pafter(s,c) = if(eq(c,10),pend(s),if(eq(c,41),pclose(s),if(eq(c,44),if(lt(0,get(s,2)),pnext(s,9,9,0),preject(s)),preject(s))))
fn plist_value(s,c) = if(if(eq(c,43),true,eq(c,45)),pnext(s,17,11,c),pexpect(s,c,2,16,10,2))
fn plist_first(s,c) = if(eq(c,93),pnext(s,12,18,0),plist_value(s,c))
fn plist_after(s,c) = if(eq(c,44),pnext(s,15,9,0),pexpect(s,c,93,12,18,0))
fn ppath_byte(c) = if(eq(c,1),true,if(eq(c,2),true,if(eq(c,45),true,if(eq(c,46),true,eq(c,47)))))
fn ppath_first(s,c) = if(ppath_byte(c),pnext(s,19,19,c),preject(s))
fn ppath_more(s,c) = if(eq(c,10),pend(s),if(ppath_byte(c),pe(s,19,c),preject(s)))
fn pdispatch_low(s,c,n,w,p) = if(eq(p,0),pstart(s,c,w),if(eq(p,1),pname(s,c),if(eq(p,2),pcolon(s,c),if(eq(p,3),ptype(s,c),if(eq(p,4),pheader(s,c),if(eq(p,5),pparam(s,c),if(eq(p,6),ppremise(s,c),if(eq(p,7),pparam_after(s,c),pexpect(s,c,61,9,7,0)))))))))
fn pdispatch_high(s,c,n,p) = if(eq(p,9),pvalue(s,c,n),if(eq(p,10),pempty(s,c,n),if(eq(p,11),popen(s,c),if(eq(p,12),pafter(s,c),if(eq(p,13),pexpect(s,c,2,12,10,2),if(eq(p,14),plist_first(s,c),if(eq(p,15),plist_value(s,c),if(eq(p,16),plist_after(s,c),if(eq(p,17),pexpect(s,c,2,16,10,2),if(eq(p,18),ppath_first(s,c),ppath_more(s,c)))))))))))
fn pstep(s,ts,bs) = replace_at(if(le(get(s,1),8),pdispatch_low(s,pk(ts,get(s,0)),pk(ts,add(get(s,0),1)),if(eq(pk(ts,get(s,0)),1),pword(ts,bs,get(s,0)),text("")),get(s,1)),pdispatch_high(s,pk(ts,get(s,0)),pk(ts,add(get(s,0),1)),get(s,1))),0,add(get(s,0),1))
