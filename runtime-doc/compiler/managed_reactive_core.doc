# Emit dependency policy directly from admitted declaration identities.
fn mrheader() = cat4(chr(35),text("include "),mquoted(text("reactive_values.h")),nl())
fn mrnum(d) = concat(text("0x"),utf8_text(append(append(append(append(empty(),hn(d,12)),hn(d,8)),hn(d,4)),hn(d,0))))
fn mrindex(w,d) = cat4(w,text("["),mrnum(d),text("]"))
