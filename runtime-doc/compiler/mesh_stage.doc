derive types: ints (inferred) = slice(inferred,7,sub(len(inferred),7))
derive check_seed: int (types,decl_count,stage,bindings,outputs) = if(if(eq(len(types),decl_count),if(le(decl_count,512),if(if(eq(stage,0),eq(len(outputs),7),if(eq(stage,1),eq(len(outputs),3),false)),eq(len(bindings),mul(decl_count,4)),false),false),false),0,bad())
