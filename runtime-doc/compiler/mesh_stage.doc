derive infer_seed: ints (structure,gnumbers,event_count,asset_paths) = if(if(eq(len(asset_paths),6),if(eq(len(structure),1),eq(len(gnumbers),event_count),false),false),append(append(append(append(append(append(append(empty(),0),0),0),0),0),0),0),preject(structure))
