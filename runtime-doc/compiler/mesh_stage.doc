derive index_initial: ints (index_seed,buckets,hashes,syntax,directory,capacity) = if(eq(gn(directory),0),index_seed,replace_at(index_seed,1,hslot(hashes,syntax,gname(directory,0),capacity)))
derive index_fill: ints (index_initial,buckets,capacity) = recur(index_initial,s,eq(len(s),add(capacity,2)),append(s,get(buckets,sub(len(s),2))))
